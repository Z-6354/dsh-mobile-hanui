{
  "name": "dsh-mobile-hanui",
  "version": "0.2.6",
  "description": "Standalone mobile UI shell for the DeepSeek Harness web GUI (phone layout, drawers, FAB, mobile composer fixes)",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./login.css": "./src/login.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-6354/dsh-mobile-hanui.git"
  },
  "scripts": {
    "test": "node scripts/bundle.mjs --check && node --test",
    "prepublishOnly": "npm test",
    "build": "node scripts/bundle.mjs",
    "check:bundle": "node scripts/bundle.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "scripts",
    "IMPLEMENTATION-2026-10-05.md"
  ]
}
